# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared secret for POST /api/mcp. Clients send it as "Authorization: Bearer <token>".
# At least 16 characters; generate one with: openssl rand -hex 32
# In production the endpoint refuses all requests until this is set.
MCP_AUTH_TOKEN=
